# Copy this file to .env on the server and fill in real values.
# Do not commit .env.

HOST=0.0.0.0
PORT=8021

# AiPPT 开放平台（在线生成3 测试）— 在 https://open.aippt.cn 账户管理获取
AIPPT_API_KEY=replace-with-aippt-api-key
AIPPT_SECRET_KEY=replace-with-aippt-secret-key
AIPPT_CHANNEL=edu.ms1001.com
AIPPT_BASE_URL=https://co.aippt.cn

# Optional defaults used when the SQLite model table has no key yet.
# After the admin panel is configured, keys are stored in data/gaokao.db.
MINIMAX_API_KEY=replace-with-minimax-key
DEEPSEEK_API_KEY=replace-with-deepseek-key

# Optional: GPT image card generation. You can also paste the key in the admin panel.
OPENAI_API_KEY=replace-with-openai-key
OPENAI_IMAGE_MODEL=gpt-image-1.5
OPENAI_IMAGE_SIZE=1024x1536
OPENAI_IMAGE_QUALITY=high

# Optional: OpenAI-compatible transit providers such as Fenno.
FENNO_API_KEY=replace-with-fenno-key

# Administrator account (auto-created on first startup if missing).
# Login with this email/password to access history migration data and admin panel.
ADMIN_EMAIL=admin@edu.ms1001.com
ADMIN_PASSWORD=change-me-to-a-strong-password

# MS1001 统一认证：与 Poster / 家教网共用账号体系。
USE_UNIFIED_AUTH=1
AUTH_BASE_URL=https://ai.ms1001.com
PUBLIC_AUTH_BASE_URL=https://ai.ms1001.com
UNIFIED_PLATFORM_ID=edu.ms1001.com

PYTHONUNBUFFERED=1
