[Unit]
Description=Gaokao AI wrong-question system
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=gaokao
Group=gaokao
WorkingDirectory=/opt/gaokao-ai
EnvironmentFile=/etc/gaokao-ai/gaokao.env
ExecStart=/usr/bin/python3 /opt/gaokao-ai/server.py
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/gaokao-ai/data /opt/gaokao-ai/web/uploads

[Install]
WantedBy=multi-user.target
